/*
 * SensorSync - encrypted sending (TLS) / envio criptografado (TLS)
 *
 * EN: Use this when the server runs with the "tls" profile. The code generated by the platform
 *     already comes with the CA certificate filled in; this example shows where it goes.
 *     1. Download the CA from https://<server>:8443/ca.crt (or http://<server>:8080/ca.crt)
 *        and paste its content into CA_CERT below.
 *     2. Fill in Wi-Fi, server address and device token.
 *     HTTPS uses port 8443; MQTT over TLS uses 8883 (useMQTT(SERVIDOR, 8883)).
 *
 * PT: Use quando o servidor roda com o perfil "tls". O codigo gerado pela plataforma ja vem com o
 *     certificado da CA preenchido; este exemplo mostra onde ele fica.
 *     1. Baixe a CA em https://<servidor>:8443/ca.crt (ou http://<servidor>:8080/ca.crt)
 *        e cole o conteudo em CA_CERT abaixo.
 *     2. Preencha Wi-Fi, endereco do servidor e token do dispositivo.
 *     HTTPS usa a porta 8443; MQTT com TLS usa a 8883 (useMQTT(SERVIDOR, 8883)).
 */
#include <SensorSync.h>

const char* WIFI_SSID     = "NOME_DA_REDE";
const char* WIFI_PASSWORD = "SENHA_DA_REDE";
// Must match a name/IP in the server certificate / Deve ser um nome ou IP do certificado do servidor
const char* SERVIDOR      = "192.168.0.10";
const char* TOKEN         = "ss_COLE_AQUI_O_TOKEN";

// Public certificate, not a secret / Certificado publico, nao e segredo
static const char CA_CERT[] = R"PEM(
-----BEGIN CERTIFICATE-----
COLE AQUI O CONTEUDO DE ca.crt / PASTE THE CONTENT OF ca.crt HERE
-----END CERTIFICATE-----
)PEM";

SensorSync sensorSync;
unsigned long ultimoEnvio = 0;

void setup() {
  Serial.begin(115200);
  sensorSync.setDebug(Serial);
  sensorSync.setToken(TOKEN);
  sensorSync.useHTTP(SERVIDOR, 8443);
  sensorSync.useTLS(CA_CERT);
  sensorSync.begin(WIFI_SSID, WIFI_PASSWORD);
}

void loop() {
  sensorSync.loop();

  if (millis() - ultimoEnvio >= 5000) {
    ultimoEnvio = millis();
    sensorSync.setValue(0, 20.0 + random(0, 100) / 10.0);  // replace with a real reading / leitura real

    unsigned long t0 = millis();
    bool ok = sensorSync.send();
    Serial.printf("%s em %lu ms (heap livre %u B)\n", ok ? "OK" : sensorSync.lastError(),
                  millis() - t0, (unsigned)ESP.getFreeHeap());
  }
}
